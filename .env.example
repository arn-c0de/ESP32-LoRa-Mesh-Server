# ESP32 LoRa Mesh Server - Build Configuration
# Copy this file to .env and fill in your values.
# These values are injected as compile-time defaults via build.sh.
# All settings can be overridden at runtime via serial commands.

# WiFi / TCP HomeServer
WIFI_SSID=MyNetwork
WIFI_PASS=MyPassword
SERVER_IP=192.168.1.100
SERVER_PORT=5001
TCP_ENABLED=1
TCP_SHARED_SECRET=my-tcp-secret

# Node Identity
NODE_ID=1
DEVICE_NAME=Node1

# Encryption (optional - passphrase used to derive AES-256 key)
# ENCRYPTION_PASSPHRASE=my-secret-key

# LoRa Radio Parameters
LORA_FREQ=868.0
LORA_POWER=14
LORA_SF=7
LORA_BW=125.0
LORA_CR=5
LORA_HOPS=3
